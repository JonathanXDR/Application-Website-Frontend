# This env file uses @env-spec - see https://varlock.dev/env-spec for more info
#
# @defaultRequired=true
# @defaultSensitive=inferFromPrefix('NUXT_PUBLIC_')
# @generateTypes(lang=ts, path=env.d.ts)
# @plugin(@varlock/infisical-plugin)
# @initInfisical(projectId=cdbc8b1c-8da2-4bfa-b231-e462c38aa447, environment=${VARLOCK_ENV:-development}, clientId=$INFISICAL_CLIENT_ID, clientSecret=$INFISICAL_CLIENT_SECRET, siteUrl=https://eu.infisical.com)
# ---

# ─── Infisical Bootstrap (shell-provided) ──────────────────────────
# Universal Auth credentials for the Infisical machine identity.
# Locally, these are exported from ~/.zshenv.
# On Vercel they are unnecessary, because the Infisical to Vercel
# integration syncs secrets directly into Vercel's process.env and the
# build script runs plain `nuxt build` without the Varlock wrapper.

# @type=infisicalClientId
# @docs("Infisical Universal Auth", https://infisical.com/docs/documentation/platform/identities/universal-auth)
INFISICAL_CLIENT_ID=

# @type=infisicalClientSecret
INFISICAL_CLIENT_SECRET=

# ─── GitHub Repository ────────────────────────────
# Public repository coordinates used by both the client and the
# GitHub API integration layer. Per-environment values in Infisical:
# development/preview envs point at the develop branch, production at main.

# @example=Application-Website-Frontend
NUXT_PUBLIC_GITHUB_REPO_NAME=infisical()

# @example=JonathanXDR
NUXT_PUBLIC_GITHUB_REPO_OWNER=infisical()

# NUXT_PUBLIC_GITHUB_REPO_BRANCH was removed. No code consumed the
# matching runtimeConfig key, and none of the GitHub endpoints take a
# branch parameter.

# ─── Analytics ────────────────────────────────────

# GA4 measurement ID consumed by @nuxt/scripts' googleAnalytics
# registry. Loaded directly via gtag.js (no GTM).
# @optional
# @example=G-XXXXXXXXXX
# @docs("Google Analytics", https://developers.google.com/analytics)
NUXT_PUBLIC_SCRIPTS_GOOGLE_ANALYTICS_ID=infisical()

# ─── GitHub API ───────────────────────────────────

# Personal access token used by the Octokit REST and GraphQL clients
# in server/api/github.
# @sensitive
# @docs("GitHub PAT", https://docs.github.com/en/authentication/keeping-your-account-and-data-secure/managing-your-personal-access-tokens)
NUXT_GITHUB_TOKEN=infisical()

# ─── Apple MusicKit ───────────────────────────────
# JWT credentials used to sign MusicKit developer tokens and to
# authorize user-level MusicKit API requests.

# PEM-encoded ES256 private key downloaded from the Apple Developer
# portal. Usually provided as a single line with `\n` escapes.
# @sensitive
# @docs("Apple MusicKit Auth", https://developer.apple.com/documentation/applemusicapi/getting-keys-and-creating-tokens)
NUXT_APPLE_DEVELOPER_PRIVATE_KEY=infisical()

# @type=string(isLength=10)
# @example=ABC123DEFG
NUXT_APPLE_DEVELOPER_KEY_ID=infisical()

# @type=string(isLength=10)
# @example=DEF456GHIJ
NUXT_APPLE_DEVELOPER_TEAM_ID=infisical()

# @sensitive
NUXT_APPLE_MUSIC_USER_TOKEN=infisical()

# ─── Site Metadata ────────────────────────────────
# Shared site identity consumed by @nuxtjs/seo, schema.org, and the
# head config in nuxt.config.ts. Per-environment values in Infisical:
# development/preview use dev.jonathan-russ.com, production uses jonathan-russ.com.

# @example="Jonathan Russ"
NUXT_SITE_NAME=infisical()

# @type=url
# @example=https://jonathan-russ.com
NUXT_SITE_URL=infisical()

# NUXT_PUBLIC_APP_DOMAIN, NUXT_PUBLIC_APP_DESCRIPTION, and
# NUXT_PUBLIC_APP_LOGO were removed. None of them had a matching
# `runtimeConfig.public` key or any consumer in app code. The page
# description comes from `content/config/site.yml` via the site-config
# middleware, and the icons are same-origin paths in `nuxt.config.ts`.

# Maps to `runtimeConfig.public.appEnvironment`, which drives the dev
# badge, the randomly colored dev favicon, and the loading indicator
# color in `app/app.vue`. Deployed environments receive their value from
# the Infisical to Vercel sync. The literal below is the local default,
# since `nuxt dev` is always a development context.
# @example=development
NUXT_PUBLIC_APP_ENVIRONMENT=development

# Secret used to sign generated og:image URLs. Must be at least
# 32 characters for adequate HMAC strength.
# @sensitive
# @type=string(minLength=32)
# @docs("Nuxt OG Image Security", https://nuxtseo.com/docs/og-image/guides/security)
NUXT_OG_IMAGE_SECRET=infisical()
