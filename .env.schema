# This env file uses @env-spec. See https://varlock.dev/env-spec for details.
#
# Type generation is manual (`auto=false`). After editing this schema, run
# `bun run env:typegen` to regenerate `env.d.ts` and commit it alongside
# the schema. `bun run env:typegen:check` verifies that the committed
# `env.d.ts` still matches.
#
# In `@initInfisical`, `environment` selects which Infisical environment slug
# to read from. VARLOCK_ENV is a Varlock built-in, auto-detected from the
# deploy platform, so it needs no schema item of its own and falls back to
# `development` locally. `cacheTtl` caches resolved secrets only on the local
# `varlock run` path, never on Vercel.
#
# @defaultRequired=true
# @defaultSensitive=inferFromPrefix('NUXT_PUBLIC_')
# @generateTypes(lang=ts, path=env.d.ts, auto=false)
# @plugin(@varlock/infisical-plugin)
# @initInfisical(projectId=cdbc8b1c-8da2-4bfa-b231-e462c38aa447, environment=${VARLOCK_ENV:-development}, clientId=$INFISICAL_CLIENT_ID, clientSecret=$INFISICAL_CLIENT_SECRET, siteUrl=https://eu.infisical.com, cacheTtl=1h)
# ---

# ─── Infisical Bootstrap (shell-provided) ─────────
# Universal Auth credentials for the Infisical machine identity, exported
# locally from `~/.zshenv`. They are not needed on Vercel, where the Infisical
# Vercel Secret Sync injects secrets into `process.env` and the build runs
# plain `nuxt build` without the Varlock wrapper. The Client Secret is the
# only real credential here, so protect and rotate it.

# @type=infisicalClientId
# @docs("Infisical Universal Auth", https://infisical.com/docs/documentation/platform/identities/universal-auth)
INFISICAL_CLIENT_ID=

# @type=infisicalClientSecret @sensitive @internal
INFISICAL_CLIENT_SECRET=

# ─── Package Registry (build-time) ────────────────
# Credentials for the private GitHub Packages registry that hosts the npm
# package `@jonathanxdr/iconify-json-sf-symbols`. They are read by the package
# manager at install time, not by the Nuxt app, so they are not NUXT_ vars.
# Locally, installs use the developer's global `~/.npmrc`, so both are
# optional here. On Vercel they arrive through the Infisical Vercel Secret Sync.

# Fine-grained GitHub PAT scoped to Packages with read-only access. The
# `.npmrc` in NPM_RC references it as `${GITHUB_PACKAGES_TOKEN}`, so it only
# needs to exist where installs run, namely the Vercel build or CI.
# @optional
# @sensitive
# @internal
# @docs("GitHub Packages npm registry", https://docs.github.com/en/packages/working-with-a-github-packages-registry/working-with-the-npm-registry)
GITHUB_PACKAGES_TOKEN=infisical()

# Full `.npmrc` contents. NPM_RC is the special variable name Vercel
# recognizes and writes to disk verbatim at build time. The `.npmrc` maps the
# `@jonathanxdr` scope to GitHub Packages and authenticates with
# `${GITHUB_PACKAGES_TOKEN}`, which the package manager, not Vercel, expands
# at install time. GITHUB_PACKAGES_TOKEN must therefore also exist in the
# build environment. The default registry stays https://registry.npmjs.org so
# every other dependency installs from the canonical npm registry.
# @optional
# @sensitive
# @internal
# @docs("Vercel private dependencies", https://vercel.com/guides/using-private-dependencies-with-vercel)
NPM_RC=infisical()

# ─── GitHub Repository ────────────────────────────
# Public owner and name identifying the repository the site reads from.

# @example=Application-Website-Frontend
NUXT_PUBLIC_GITHUB_REPO_NAME=infisical()

# @example=JonathanXDR
NUXT_PUBLIC_GITHUB_REPO_OWNER=infisical()

# ─── Analytics ────────────────────────────────────

# GA4 measurement ID. Public, exposed to the browser by design.
# @optional
# @example=G-XXXXXXXXXX
# @docs("Google Analytics", https://developers.google.com/analytics)
NUXT_PUBLIC_SCRIPTS_GOOGLE_ANALYTICS_ID=infisical()

# ─── GitHub API ───────────────────────────────────

# Personal access token that authenticates server-side GitHub API calls.
# Never exposed to the client.
# @sensitive
# @docs("GitHub PAT", https://docs.github.com/en/authentication/keeping-your-account-and-data-secure/managing-your-personal-access-tokens)
NUXT_GITHUB_TOKEN=infisical()

# ─── Apple MusicKit ───────────────────────────────
# JWT credentials for signing MusicKit developer tokens and authorizing
# user-level MusicKit requests. The Key ID and Team ID are non-secret
# identifiers (the Key ID is sent in the signed JWT header), so they are
# public. The private key and the user token are the real secrets and stay
# sensitive.

# Base64 encoding of the ES256 `.p8` private key from the Apple Developer portal
# (`base64 -i AuthKey_XXXX.p8`). The server decodes it back to PEM before
# signing, so do not store raw PEM text or a single-line PEM with escaped
# newlines here.
# @sensitive
# @docs("Apple MusicKit Auth", https://developer.apple.com/documentation/applemusicapi/getting-keys-and-creating-tokens)
NUXT_APPLE_DEVELOPER_PRIVATE_KEY=infisical()

# @public @type=string(matches=/^[A-Z0-9]{10}$/)
# @example=ABC123DEFG
NUXT_APPLE_DEVELOPER_KEY_ID=infisical()

# @public @type=string(matches=/^[A-Z0-9]{10}$/)
# @example=DEF456GHIJ
NUXT_APPLE_DEVELOPER_TEAM_ID=infisical()

# @sensitive
NUXT_APPLE_MUSIC_USER_TOKEN=infisical()

# ─── Flick API ────────────────────────────────────
# Read-only access to the owner's own Flick account: profile, reviews,
# watchlist, custom lists, tags, follows, and in-progress shows. A key acts on
# behalf of the account that created it and that is the only scope it has, so
# there is no OAuth and no route to anyone else's data. Server-side only.
# Revoking a key takes effect within about 30 seconds.

# API key authenticating the server-side Flick calls. Requires a Flick Pro
# subscription, and the full value is shown only once, at creation. Every
# `/api/flick/*` route stays inert at 404 until this resolves, so an unset key
# degrades the feature rather than breaking the build.
# @sensitive
# @type=string(startsWith=flick_sk_)
# @example=flick_sk_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
# @docs("Flick API keys", https://flickmovies.com/developers/keys)
# @docs("Flick API reference", https://flickmovies.com/developers/docs)
NUXT_FLICK_API_KEY=infisical()

# ─── Site Metadata ────────────────────────────────
# Shared site identity used to set the site name and URL across SEO,
# schema.org, and the document head. The per-environment Infisical values
# differ: development and preview use `dev.jonathan-russ.com`, and production
# uses `jonathan-russ.com`.

# Public site name rendered into every SSR page (canonical, og:url, hreflang,
# schema.org), not a secret.
# @public
# @example="Jonathan Russ"
NUXT_SITE_NAME=infisical()

# @public
# @type=url(noTrailingSlash=true)
# @example=https://jonathan-russ.com
NUXT_SITE_URL=infisical()

# Selects the runtime environment. Deployed values come from the Infisical
# Vercel Secret Sync. The literal below is the local default, since `nuxt dev`
# is always a development context.
# @type=enum(development, preview, production)
# @example=development
NUXT_PUBLIC_APP_ENVIRONMENT=development

# Signs generated `og:image` URLs (minimum 32 characters for HMAC strength).
# Optional while the `og:image` assets are prerendered static files, since no
# secret is read at runtime. It becomes required if runtime `og:image` signing
# is enabled.
# @optional
# @sensitive
# @type=string(minLength=32)
# @docs("Nuxt OG Image Security", https://nuxtseo.com/docs/og-image/guides/security)
NUXT_OG_IMAGE_SECRET=infisical()

# ─── System (platform-provided) ───────────────────
# Ambient variables set by Node and Vercel. They have no `infisical()`
# resolver and are optional, since they are absent in local non-Vercel runs.

# Set by Node and Nuxt, not something you configure.
# @optional
# @public
# @type=enum(development, production, test)
NODE_ENV=

# Set to 1 on Vercel only.
# @optional
# @public
VERCEL=

# The active Vercel deployment environment.
# @optional
# @public
# @type=enum(production, preview, development)
VERCEL_ENV=
