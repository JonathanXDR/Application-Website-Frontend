    "lint-staged": "17.0.5",
    "motion-v": "2.2.1",
    "neostandard": "0.13.0",
    "nuxt": "4.4.6",
    "nuxt-security": "2.6.0",
    "nuxt-viewport": "2.4.0",
    "octokit": "5.0.5",
    "sass-embedded": "1.100.0",
    "skilld": "2.0.0",
    "tailwindcss": "4.3.0",
    "typescript": "6.0.3",
    "varlock": "1.2.0",
    "vue": "3.5.34",
    "vue-router": "5.0.7",
    "vue-tsc": "3.3.1",
    "zod": "4.4.3"
