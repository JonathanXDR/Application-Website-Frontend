    "@iconify-json/fa7-solid": "1.2.4",
    "@iconify-json/logos": "1.2.11",
    "@iconify-json/simple-icons": "1.2.83",
    "@nuxt/content": "3.14.0",
    "@nuxt/devtools": "3.2.4",
    "@nuxt/eslint": "1.15.2",
    "@nuxt/hints": "1.1.2",
    "@nuxt/icon": "2.2.2",
    "@nuxt/image": "2.0.0",
    "@nuxt/scripts": "1.1.1",
    "@nuxtjs/color-mode": "4.0.0",
    "@nuxtjs/i18n": "10.4.0",
    "@nuxtjs/seo": "5.1.3",
    "@octokit/graphql": "9.0.3",
    "@octokit/graphql-schema": "15.26.1",
    "@octokit/openapi-types": "27.0.0",
    "@octokit/types": "16.0.0",
    "@tailwindcss/vite": "4.3.0",
    "@types/jsonwebtoken": "9.0.10",
    "@types/musickit-js": "1.0.11",
    "@types/node": "25.9.1",
    "@varlock/infisical-plugin": "1.1.0",
    "@vercel/analytics": "2.0.1",
    "@vercel/speed-insights": "2.0.0",
    "@vueuse/core": "14.3.0",
    "@vueuse/integrations": "14.3.0",
    "@vueuse/nuxt": "14.3.0",
    "@vueuse/sound": "2.1.3",
    "css.escape": "1.5.1",
    "dayjs": "1.11.20",
    "eslint": "9.39.4",
    "eslint-plugin-prettier": "5.5.5",
    "husky": "9.1.7",
