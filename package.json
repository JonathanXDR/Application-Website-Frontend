    "@takumi-rs/core": "2.14.0",
    "@takumi-rs/wasm": "2.14.0",
    "better-sqlite3": "13.0.3"
  },
  "trustedDependencies": [
    "better-sqlite3",
    "esbuild",
    "puppeteer",
    "unrs-resolver",
    "vue-demi"
  ]
}
