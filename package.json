{
  "name": "application-website",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "check:build": "sh ./scripts/check-build.sh",
    "cleanup:icons": "sh ./scripts/cleanup-icons.sh",
    "dev": "varlock run -- nuxt dev",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "generate": "nuxt generate",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "postinstall": "nuxt prepare",
    "prepare": "husky && skilld prepare",
    "preview": "varlock run -- nuxt preview",
    "typecheck": "nlx nuxi typecheck"
  },
  "devDependencies": {
    "@antfu/ni": "30.1.0",
    "@commitlint/cli": "21.0.1",
    "@commitlint/config-conventional": "21.0.1",
