{
  "name": "application-website",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "check:build": "sh ./scripts/check-build.sh",
    "dev": "varlock run -- nuxt dev",
    "env:typegen": "varlock typegen && prettier --write env.d.ts",
    "env:typegen:check": "varlock typegen && prettier --write env.d.ts && git diff --exit-code -- env.d.ts",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "generate": "nuxt generate",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "postinstall": "nuxt prepare",
    "prepare": "husky",
    "preview": "varlock run -- nuxt preview",
    "typecheck": "nlx nuxi typecheck"
  },
  "devDependencies": {
    "@alwaysmeticulous/recorder-plugin": "2.346.0",
    "@antfu/ni": "30.6.0",
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@iconify-json/fa7-brands": "1.2.4",
    "@iconify-json/fa7-solid": "1.2.5",
    "@iconify-json/logos": "1.2.15",
    "@iconify-json/simple-icons": "1.2.99",
    "@iconify/types": "2.0.0",
    "@jonathanxdr/iconify-json-sf-symbols": "1.0.0",
    "@nuxt/content": "github:JonathanXDR/content#release/better-i18n",
    "@nuxt/devtools": "3.4.2",
    "@nuxt/eslint": "1.17.0",
    "@nuxt/hints": "1.1.4",
    "@nuxt/icon": "2.5.1",
    "@nuxt/image": "2.1.0",
    "@nuxt/scripts": "1.3.12",
    "@nuxtjs/color-mode": "4.0.1",
    "@nuxtjs/i18n": "10.6.0",
    "@nuxtjs/seo": "5.3.16",
    "@octokit/graphql": "9.0.5",
    "@octokit/graphql-schema": "15.26.1",
    "@octokit/openapi-types": "29.0.1",
    "@octokit/types": "18.0.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/jsonwebtoken": "9.0.10",
    "@types/musickit-js": "1.0.11",
    "@types/node": "26.6.5",
    "@varlock/infisical-plugin": "2.1.3",
    "@vercel/analytics": "2.0.1",
    "@vercel/speed-insights": "2.0.0",
    "@vueuse/core": "15.0.0",
    "@vueuse/integrations": "15.0.0",
    "@vueuse/nuxt": "15.0.0",
    "@vueuse/sound": "2.1.3",
    "css.escape": "1.5.1",
    "dayjs": "1.11.23",
    "eslint": "10.12.0",
    "eslint-plugin-prettier": "5.5.6",
    "husky": "9.1.7",
    "jsonwebtoken": "9.0.3",
    "lint-staged": "17.6.0",
    "motion-v": "2.6.0",
    "neostandard": "0.14.0",
    "nuxt": "4.6.1",
    "nuxt-ai-ready": "2.5.3",
    "nuxt-security": "2.6.0",
    "nuxt-skew-protection": "1.6.2",
    "nuxt-viewport": "2.6.1",
    "octokit": "5.0.5",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "unlighthouse": "0.19.1",
    "varlock": "1.22.0",
    "vue": "3.5.43",
