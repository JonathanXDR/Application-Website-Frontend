{
  "name": "application-website",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "check:build": "sh ./scripts/check-build.sh",
    "dev": "varlock run -- nuxt dev",
    "env:typegen": "varlock typegen && prettier --write env.d.ts",
    "env:typegen:check": "varlock typegen && prettier --write env.d.ts && git diff --exit-code -- env.d.ts",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "generate": "nuxt generate",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "postinstall": "nuxt prepare",
    "prepare": "husky && skilld prepare",
    "preview": "varlock run -- nuxt preview",
    "typecheck": "nlx nuxi typecheck"
  },
  "devDependencies": {
    "@alwaysmeticulous/recorder-plugin": "2.293.0",
    "@antfu/ni": "30.5.0",
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "@iconify-json/fa7-brands": "1.2.4",
    "@iconify-json/fa7-solid": "1.2.5",
    "@iconify-json/logos": "1.2.13",
    "@iconify-json/simple-icons": "1.2.93",
    "@iconify/types": "2.0.0",
    "@jonathanxdr/iconify-json-sf-symbols": "0.1.0",
    "@nuxt/content": "github:JonathanXDR/content#release/better-i18n",
    "@nuxt/devtools": "3.4.2",
    "@nuxt/eslint": "1.17.0",
    "@nuxt/hints": "1.1.4",
    "@nuxt/icon": "2.5.0",
    "@nuxt/image": "2.1.0",
    "@nuxt/scripts": "1.3.8",
    "@nuxtjs/color-mode": "4.0.1",
    "@nuxtjs/i18n": "10.6.0",
    "@nuxtjs/seo": "5.3.14",
    "@octokit/graphql": "9.0.4",
    "@octokit/graphql-schema": "15.26.1",
    "@octokit/openapi-types": "28.0.0",
    "@octokit/types": "17.0.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/jsonwebtoken": "9.0.10",
    "@types/musickit-js": "1.0.11",
    "@types/node": "26.2.0",
    "@varlock/infisical-plugin": "2.1.0",
    "@vercel/analytics": "2.0.1",
    "@vercel/speed-insights": "2.0.0",
    "@vueuse/core": "14.4.0",
    "@vueuse/integrations": "14.4.0",
    "@vueuse/nuxt": "14.4.0",
    "@vueuse/sound": "2.1.3",
    "css.escape": "1.5.1",
    "dayjs": "1.11.23",
    "eslint": "10.9.0",
    "eslint-plugin-prettier": "5.5.6",
    "husky": "9.1.7",
    "jsonwebtoken": "9.0.3",
    "lint-staged": "17.3.0",
    "motion-v": "2.4.0",
    "neostandard": "0.14.0-next.1",
    "nuxt": "4.5.2",
    "nuxt-ai-ready": "2.0.1",
    "nuxt-security": "2.6.0",
    "nuxt-skew-protection": "1.5.1",
    "nuxt-viewport": "2.6.1",
    "octokit": "5.0.5",
    "skilld": "2.3.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "unlighthouse": "0.18.0",
    "varlock": "1.17.0",
    "vue": "3.5.41",
    "vue-router": "5.2.0",
    "vue-tsc": "3.3.11",
    "yaml": "2.9.0",
    "zod": "4.4.3"
  },
  "dependencies": {
    "@takumi-rs/core": "2.11.0",
    "@takumi-rs/wasm": "2.11.0",
    "better-sqlite3": "13.0.3"
  }
}
